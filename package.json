{
  "name": "pullwave",
  "version": "0.19.2",
  "description": "Cyberpunk yt-dlp GUI and video downloader for Linux and Windows",
  "main": "out/main/index.js",
  "author": {
    "name": "monothread",
    "email": "realrukasu@proton.me"
  },
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "desktopName": "pullwave.desktop",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint src/ test/ --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "dist": "npm run check:tools && npm run fetch-binaries && npm run build && electron-builder --linux AppImage deb rpm pacman --publish never",
    "fetch-binaries": "node scripts/fetch-binaries.mjs",
    "release": "npm run check:tools && npm run fetch-binaries && npm run build && electron-builder --linux AppImage deb rpm pacman --publish always",
    "dist:win": "npm run fetch-binaries && npm run build && electron-builder --win nsis --x64 --publish never",
    "release:win": "npm run fetch-binaries && npm run build && electron-builder --win nsis --x64 --publish always",
    "check:tools": "node scripts/check-linux-tools.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "hls.js": "^1.7.3",
    "openpgp": "^6.3.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "homepage": "https://github.com/monothread/pullwave",
  "repository": {
    "type": "git",
    "url": "https://github.com/monothread/pullwave.git"
  },
  "overrides": {
    "@electron/get": "^5.1.0"
  }
}
