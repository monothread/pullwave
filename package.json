{
  "name": "pullwave",
  "version": "0.29.9",
  "description": "Desktop video downloader (yt-dlp), anime library & player (ani-cli), and manga reader (Mihon/Tachiyomi) for Linux and Windows.",
  "main": "out/main/index.js",
  "author": {
    "name": "monothread",
    "email": "realrukasu@proton.me"
  },
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=26"
  },
  "desktopName": "pullwave.desktop",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint src/ test/ --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "npm run build && npm run e2e:side-by-side -- --grep-invert @full; side=$?; npm run e2e:screen; exit $(( side || $? ))",
    "test:e2e:full": "npm run build && npm run e2e:side-by-side; side=$?; npm run e2e:screen; exit $(( side || $? ))",
    "e2e:side-by-side": "playwright test --project=secondary --project=primary-files",
    "e2e:screen": "playwright test --project=primary-tagged",
    "screenshots": "npm run build && xvfb-run -a -s \"-screen 0 3440x1440x24\" playwright test -c scripts/screenshots/playwright.config.ts",
    "dist": "npm run build && electron-builder --linux AppImage --publish never",
    "fetch-binaries": "node scripts/fetch-binaries.mjs",
    "release": "npm run build && electron-builder --linux AppImage --publish always",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "release:win": "npm run build && electron-builder --win nsis --x64 --publish always",
    "prepare": "git config core.hooksPath .githooks || true",
    "audit:check": "npm audit --audit-level=low"
  },
  "dependencies": {
    "canvas-confetti": "1.9.4",
    "electron-updater": "^6.8.11",
    "hls.js": "^1.7.4",
    "motion": "14.7.1",
    "openpgp": "^6.3.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tar": "^7.5.23",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.11.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.8",
    "vitest": "^5.1.1"
  },
  "homepage": "https://github.com/monothread/pullwave",
  "repository": {
    "type": "git",
    "url": "https://github.com/monothread/pullwave.git"
  },
  "overrides": {
    "@electron/get": "^5.1.0",
    "minimatch": "^11.0.4"
  }
}
