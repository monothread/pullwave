#!/bin/sh
# Blocks any push to main while `npm audit` reports a vulnerability (any severity, dev dependencies included).
# Enabled by `npm install` (the "prepare" script points core.hooksPath here). Fix the vulnerability before pushing.

zero_sha="0000000000000000000000000000000000000000"
pushes_to_main=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ] && [ "$local_sha" != "$zero_sha" ]; then
    pushes_to_main=1
  fi
done

if [ "$pushes_to_main" -eq 0 ]; then
  exit 0
fi

echo "pre-push: auditing dependencies before pushing to main..."

if ! npm audit --audit-level=low; then
  echo ""
  echo "pre-push: push to main BLOCKED, npm audit found vulnerabilities."
  echo "Fix them (npm audit fix, bump the package or add an override), then push again."
  exit 1
fi

echo "pre-push: no vulnerabilities found."
